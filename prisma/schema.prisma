generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     FamilyMember[]
  expenses        Expense[]
  sessions        Session[]
  invitesSent     FamilyInvite[] @relation("InvitesSent")
  invitesReceived FamilyInvite[] @relation("InvitesReceived")
  notifications   Notification[]
}

model Family {
  id        String   @id @default(cuid())
  name      String
  budget    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    FamilyMember[]
  expenses   Expense[]
  categories Category[]
  cards      Card[]
  invites    FamilyInvite[]
}

model FamilyMember {
  id       String  @id @default(cuid())
  role     String  @default("member")
  budget   Float   @default(0)

  userId   String
  familyId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  limitAmount Float    @default(0)
  createdAt   DateTime @default(now())

  familyId String
  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses Expense[]
}

model Card {
  id                   String   @id @default(cuid())
  name                 String
  /// Imagem do cartão (data URL), formato horizontal recortado no cliente.
  image                String?
  /// Dia do mês em que a fatura fecha (1–31), opcional — referência nas configurações.
  statementClosingDay  Int?
  /// Dias após o fechamento até o vencimento (referência).
  dueDayOffset         Int      @default(7)
  createdAt            DateTime @default(now())

  familyId String
  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses Expense[]
}

model Expense {
  id                 String   @id @default(cuid())
  name               String
  invoiceId          String?
  /// Referência da fatura (YYYY-MM): mês do fechamento do ciclo em que o gasto entra (cartão com fechamento), ou mês civil da data (sem cartão / sem fechamento).
  billingYm          String   @default("2000-01")
  amount             Float
  date               DateTime
  type               String   @default("avulsa")
  totalInstallments  Int?
  currentInstallment Int?
  pending            Boolean  @default(false)
  createdAt          DateTime @default(now())

  familyId      String
  categoryId    String?
  responsibleId String
  cardId        String?

  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])
  responsible User      @relation(fields: [responsibleId], references: [id])
  card        Card?     @relation(fields: [cardId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyInvite {
  id        String   @id @default(cuid())
  status    String   @default("pending") // pending | accepted | declined
  budget    Float    @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  familyId  String
  inviterId String
  inviteeId String

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviter User   @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User   @relation("InvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  read        Boolean  @default(false)
  metadata    String?
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
