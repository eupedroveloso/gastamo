# Copie para .env.local e preencha (não commite segredos).
# String: Prisma Console → seu banco → connection string
#
# Aceita qualquer uma destas (primeira definida ganha):
#   DATABASE_URL, POSTGRES_URL, PRISMA_DATABASE_URL
# Na Vercel às vezes vêm com prefixo do projeto:
#   gastamo_DATABASE_URL, gastamo_POSTGRES_URL, gastamo_PRISMA_DATABASE_URL

DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"

# Cron do relatório semanal (domingo ~16h Brasília): defina na Vercel e use o mesmo valor no agendamento.
# CRON_SECRET=uma_string_secreta_longa
